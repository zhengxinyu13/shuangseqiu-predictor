# 默认按内容自动识别文本/二进制
* text=auto

# 源码统一 LF 换行，避免跨平台 diff 噪音
*.py   text eol=lf
*.spec text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.html text eol=lf
*.txt  text eol=lf

# Windows 批处理脚本用 CRLF，避免 cmd.exe 解析跨行结构出问题
*.bat  text eol=crlf

# 二进制资源，禁止做文本 diff / 换行转换
*.xlsx binary
*.xls  binary
*.csv  text eol=lf
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.pkl  binary
*.joblib binary
*.h5   binary
*.pt   binary
*.onnx binary
